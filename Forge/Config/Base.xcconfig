// Shared build settings. Personal values go in Local.xcconfig (git-ignored).
PRODUCT_BUNDLE_IDENTIFIER = app.forge.ios
PRODUCT_NAME = Forge
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Proxy. PROXY_URL is set in Local.xcconfig. PROXY_TOKEN is a developer token
// for simulators and debug builds; release builds carry none and prove
// themselves with App Attest (decision 0021).
PROXY_URL =
PROXY_TOKEN =

#include? "Local.xcconfig"

// After the include so it wins: no token in any Release build.
PROXY_TOKEN[config=Release] =
CODE_SIGN_ENTITLEMENTS = Forge/Config/Forge.entitlements
