// Shared build settings. Personal values go in Local.xcconfig (git-ignored).
PRODUCT_BUNDLE_IDENTIFIER = app.forge.ios
PRODUCT_NAME = Forge
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Proxy address. Overridden by Local.xcconfig. No token is built into the app any more (PARKED.md).
PROXY_URL =

// The check ledger's copy in iCloud (decision 0043). Off until Local.xcconfig turns it on.
HUNCH_LEDGER_IN_ICLOUD = NO

#include? "Local.xcconfig"
