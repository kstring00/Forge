{
  "name": "hunch-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The engine's test suite (docs/ENGINE.md §6): real ideas, hand-written answer keys, two baselines, one report.",
  "scripts": {
