{
  "name": "forge-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FORGE's serverless AI proxy: holds the Anthropic key, validates JSON contracts, runs desk research.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "schema": "tsx scripts/dump-schema.ts",
    "dev": "vercel dev",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@upstash/redis": "^1.41.0",
    "cbor-x": "^1.6.9",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
