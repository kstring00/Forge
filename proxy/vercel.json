{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/action.ts": { "maxDuration": 300, "memory": 1024 },
    "api/research.ts": { "maxDuration": 120, "memory": 1024 },
    "api/health.ts": { "maxDuration": 10, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/health" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
